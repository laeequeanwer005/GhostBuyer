# Copy to .env. This application deliberately uses ONLY the PayPal Sandbox API.
PORT=3100
HOST=127.0.0.1
# Create a REST API app with a PayPal Sandbox Business account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox business account -> Enable Negative Testing for rejected-capture experiments.
ENABLE_NEGATIVE_TESTING=false
# AI uses OpenAI Responses API structured JSON. Model names are customizable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set for custom Chrome/Chromium binary; browser automation is local only.
CHROME_PATH=
